# StrikeNote 環境變數範本。複製到 /etc/strikenote/env（chmod 600），每行 KEY=VALUE。
# 開發機：直接 export 或用 `set -a; . deploy/env.example; set +a` 帶入（先改密碼）。

# ---- 網路 ----
# 只聽本機：對外由 cloudflared / 反向代理接進來。開發機可改 0.0.0.0。
HOST=127.0.0.1
PORT=8080
# 1 = 信任代理送來的 X-Forwarded-Proto / CF-Visitor / CF-Connecting-IP / X-Forwarded-For。
# 放在 cloudflared、nginx、Caddy 後面時設 1；直接暴露（不建議）時設 0。
TRUST_PROXY=1
# 1 = 非 HTTPS 的請求 301 到 https、cookie 加 Secure。只有本機純 HTTP 測試才設 0。
REQUIRE_HTTPS=1

# ---- MariaDB ----
DB_HOST=127.0.0.1
DB_PORT=3306
# 建議走 unix socket（設了會優先於 DB_HOST/DB_PORT）：只要 60-strikenote.cnf 的
# skip-name-resolve=1 有套用，MariaDB 對 TCP 127.0.0.1 就只比對字面 IP，不再等於
# 'user'@'localhost'，TCP 連線會被拒絕——socket 連線不受影響，一律算 localhost。
# Debian/Raspberry Pi OS 的路徑通常是 /run/mysqld/mysqld.sock。
DB_SOCKET=/run/mysqld/mysqld.sock
DB_NAME=strikenote
DB_USER=strikenote
DB_PASSWORD=CHANGE_ME

# ---- 帳號 ----
# open | invite | closed。上線後建議 closed；invite 模式沒設 INVITE_CODE 會每次重啟隨機產生。
REGISTER_MODE=closed
INVITE_CODE=
ADMIN_USERNAME=admin
# 留空 = 首次啟動隨機產生並印在 log、首登強制更改。
ADMIN_PASSWORD=
SESSION_TTL_DAYS=14
MIN_PASSWORD_LENGTH=12
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ---- 大小上限 ----
# 圖片/PDF 上傳與電子書分享連結的 JSON body 上限（bytes）。要允許 40 MB 的書就設 48 MiB；
# 必須小於 MariaDB 的 max_allowed_packet（deploy/mariadb/60-strikenote.cnf 設 64M）與 Cloudflare 的 100 MB。
MAX_BODY_BYTES=50331648

# ---- 磁碟空間警告（看 MariaDB 資料目錄所在的檔案系統）----
STORAGE_WARN_MB=1024
STORAGE_WARN_PCT=10

# ---- 備份（deploy/backup.sh）----
BACKUP_DIR=/var/backups/strikenote
BACKUP_KEEP_DAYS=14
# 選填：rclone 遠端（例如 gdrive:strikenote-backups），設了就多複製一份到異地。
RCLONE_REMOTE=
