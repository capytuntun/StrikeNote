# Files that end up on a Linux host must stay LF even when checked out on
# Windows (core.autocrlf=true would otherwise CRLF them and break bash/systemd).
deploy/** text eol=lf
*.sh text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.cnf text eol=lf
*.sql text eol=lf
*.yml text eol=lf

# vendor/drawio/ is draw.io's release, copied in by server/tools/vendor-drawio.js.
# Store and check out every file byte-for-byte: no line-ending conversion in
# either direction, so what is served is exactly what upstream shipped.
vendor/drawio/** -text
